<Window x:Class="PhoenixLeecher.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Phoenix Leecher" Height="340" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="28" VerticalAlignment="Center">
        <Image Source="Assets/app.ico" Width="72" Height="72" Margin="0,0,0,16"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Phoenix Leecher" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,4,0,16"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SubtleTextBrush}"/>
        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   Text="Paste a page URL to auto-find pCloud and MediaFire share links. Scan crawls older blog posts — up to 50 links, resumable across restarts. Same folder on both hosts downloads once, with the other kept as automatic fallback."/>
        <Button Content="OK" Width="90" Margin="0,20,0,0" Padding="8,5"
                HorizontalAlignment="Center" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
</Window>
