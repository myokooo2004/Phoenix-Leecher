<Window x:Class="PhoenixLeecher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhoenixLeecher"
        xmlns:models="clr-namespace:PhoenixLeecher.Models"
        Title="Phoenix Leecher" Height="620" Width="1040"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:BytesConverter x:Key="Bytes"/>
        <local:SpeedConverter x:Key="Speed"/>
        <local:ElapsedConverter x:Key="Elapsed"/>
        <local:StatusToBarBrushConverter x:Key="BarBrush"/>
        <local:SizePairConverter x:Key="SizePair"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="File">
                <MenuItem Header="Open download folder" Click="OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Downloads">
                <MenuItem Header="Download all" Click="DownloadAll_Click"/>
                <MenuItem Header="Pause all" Click="PauseAll_Click"/>
                <MenuItem Header="Resume all" Click="ResumeAll_Click"/>
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Max concurrent files">
                    <MenuItem Header="1" Click="Concurrency_Click" Tag="1"/>
                    <MenuItem Header="2" Click="Concurrency_Click" Tag="2"/>
                    <MenuItem Header="3" Click="Concurrency_Click" Tag="3" IsChecked="True"/>
                    <MenuItem Header="5" Click="Concurrency_Click" Tag="5"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Light mode" Click="ThemeLight_Click" x:Name="MenuLight" IsChecked="True"/>
                <MenuItem Header="Dark mode" Click="ThemeDark_Click" x:Name="MenuDark"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About Phoenix Leecher" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Background="{DynamicResource PanelBackground}">
                <TextBox x:Name="UrlBox" Width="380" Margin="4"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderStrongBrush}"
                         VerticalContentAlignment="Center" Padding="6,4"/>
                <!-- Scan group -->
                <Button x:Name="PageScanBtn" Click="PageScan_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Find share links on the pasted page only">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Page scan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="WholeScan_Click" Margin="2" Padding="8,4" x:Name="ScanBtn"
                        Style="{StaticResource FlatButton}" ToolTip="Scan the whole site until 50 links">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Whole scan" VerticalAlignment="Center" x:Name="ScanBtnLabel"/>
                    </StackPanel>
                </Button>
                <Button Click="Stop_Click" Margin="2" Padding="8,4" x:Name="StopBtn" IsEnabled="False"
                        Style="{StaticResource FlatButton}" ToolTip="Stop scan">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,6"/>
                <!-- Download group -->
                <Button Click="DownloadAll_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Download all entries">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Download All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="PauseAll_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Pause all downloads">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Pause All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,6"/>
                <!-- Organize group -->
                <Button Click="OpenFolder_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Open download folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="RemoveCompleted_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Remove all completed entries from the list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Remove completed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="DeleteSelected_Click" Margin="2" Padding="8,4"
                        Style="{StaticResource FlatButton}" ToolTip="Remove selected entry">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,6"/>
                <!-- View -->
                <Button Click="ThemeToggle_Click" Margin="2" Padding="8,4" x:Name="ThemeBtn"
                        Style="{StaticResource FlatButton}" ToolTip="Toggle dark mode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Dark" VerticalAlignment="Center" x:Name="ThemeBtnLabel"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Scan status strip -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,6" x:Name="ScanStrip" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ScanText" VerticalAlignment="Center" DockPanel.Dock="Left"
                           Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,12,0"/>
                <ProgressBar x:Name="ScanBar" Height="10" Minimum="0" Maximum="50"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"/>
                <TextBlock Text="state saved — resumable" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}"
                   Foreground="{DynamicResource SubtleTextBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusCounts"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusSpeed"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusFolder" Foreground="{DynamicResource FaintTextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main table -->
        <Grid>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" GridLinesVisibility="None" HeadersVisibility="Column"
                  Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}"
                  BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <!-- Kill the system bright-blue selection everywhere inside the grid:
                     our SelectedRowBrush trigger owns the selection look. -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3F4FD1C5"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2E4FD1C5"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2E4FD1C5"/>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverRowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                            <!-- Fix 2026-10-16: selected text was invisible (white system
                                 HighlightText on light teal). Force theme text color. -->
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Belt and suspenders: selected cells use our brush, never system blue. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                            <!-- Fix 2026-10-16: keep text readable when selected. -->
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- No. (1-based row number) -->
                <DataGridTextColumn Header="No." Binding="{Binding RowNumber}" Width="45">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Name -->
                <DataGridTemplateColumn Header="Name" Width="2.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource FaintTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding FileCount, StringFormat='{}{0} files'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                    <Setter Property="Text" Value="file"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DedupNote}" FontSize="11"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           Visibility="{Binding HasBackup, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Progress / password -->
                <DataGridTemplateColumn Header="Progress" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid x:Name="BarGrid">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                 Height="16" BorderThickness="1"
                                                 BorderBrush="{DynamicResource BorderStrongBrush}"
                                                 Background="{DynamicResource ProgressTrackBrush}"
                                                 Foreground="{Binding Status, Converter={StaticResource BarBrush}}"/>
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource ProgressTextBrush}"/>
                                </Grid>
                                <StackPanel x:Name="PwPanel" Orientation="Horizontal" Visibility="Collapsed">
                                    <PasswordBox x:Name="PwBox" Width="130" Margin="0,0,6,0"
                                                 PasswordChanged="PwBox_PasswordChanged"
                                                 Background="{DynamicResource InputBackground}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource WarningBrush}"/>
                                    <Button Content="Unlock" Click="Unlock_Click" Padding="8,2"
                                            Style="{StaticResource FlatButton}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="NeedsPassword">
                                    <Setter TargetName="BarGrid" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="PwPanel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Speed -->
                <DataGridTemplateColumn Header="Speed" Width="0.7*">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SpeedBps, Converter={StaticResource Speed}}"
                                       HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Size -->
                <DataGridTemplateColumn Header="Size" Width="0.9*">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource SubtleTextBrush}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SizePair}">
                                        <Binding Path="DownloadedBytes"/>
                                        <Binding Path="TotalSize"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Elapsed -->
                <DataGridTemplateColumn Header="Elapsed" Width="0.6*">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Elapsed, Converter={StaticResource Elapsed}}"
                                       HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource FaintTextBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Host -->
                <DataGridTemplateColumn Header="Host" Width="0.7*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BadgePCloudBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BadgePCloudBd}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrimaryHost}" Value="mediafire">
                                                <Setter Property="Background" Value="{DynamicResource BadgeMFBg}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BadgeMFBd}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="pCloud"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BadgePCloudFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrimaryHost}" Value="mediafire">
                                                    <Setter Property="Text" Value="MediaFire"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BadgeMFFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="" Width="0.9*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button ToolTip="Download" Click="RowDownload_Click"
                                        Margin="0,0,4,0" Padding="6,2">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button ToolTip="Resume" Click="RowDownload_Click"
                                        Margin="0,0,4,0" Padding="6,2">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button ToolTip="Pause" Click="RowPause_Click"
                                        Margin="0,0,4,0" Padding="6,2">
                                    <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets"/>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="✕" ToolTip="Remove" Click="RowDelete_Click" Padding="6,2"
                                        Style="{StaticResource FlatButton}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="0,0,0,40">
                <Image Source="Assets/app.ico" Width="88" Height="88" Margin="0,0,0,20"
                       RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.92"/>
                <TextBlock Text="Phoenix Leecher (pCloud / MediaFire)" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Paste a website link above — the app automatically finds pCloud and MediaFire links on the page and lists them here for download."
                           FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                           MaxWidth="420" TextAlignment="Center"/>
                <TextBlock Text="Tip: you can also paste a pCloud or MediaFire link directly."
                           FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                           MaxWidth="420" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
