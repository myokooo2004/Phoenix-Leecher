<Window x:Class="PhoenixLeecher.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phoenix Leecher — Log" Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy" Click="Copy_Click" Padding="16,6" Margin="0,0,8,0"
                    Style="{StaticResource FlatButton}"/>
            <Button Content="Close" Click="Close_Click" Padding="16,6"
                    Style="{StaticResource FlatButton}"/>
        </StackPanel>
        <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{DynamicResource PanelBackground}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>
    </DockPanel>
</Window>
